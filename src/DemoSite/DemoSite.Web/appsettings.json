{
  "$schema": "./appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Umbraco": {
    "CMS": {
      "Content": {
        "ContentVersionCleanupPolicy": {
          "EnableCleanup": true
        }
      },
      "Global": {
        "Id": "8c75dc00-ab1d-4fda-b190-b3b8c586db7f"
      },
      "Hosting": {
        "Debug": false
      },
      "ModelsBuilder": {
        "FlagOutOfDateModels": false,
        "ModelsMode": "SourceCodeManual"
      },
      "RequestHandler": {
        "AddTrailingSlash": false,
        "ConvertUrlsToAscii": "try",
        "EnableDefaultCharReplacements": true,
        "UserDefinedCharCollection": [
          {
            "Char": " ",
            "Replacement": "-"
          },
          {
            "Char": "\\",
            "Replacement": ""
          },
          {
            "Char": "\u0027",
            "Replacement": ""
          },
          {
            "Char": "%",
            "Replacement": ""
          },
          {
            "Char": ".",
            "Replacement": ""
          },
          {
            "Char": ";",
            "Replacement": ""
          },
          {
            "Char": "/",
            "Replacement": ""
          },
          {
            "Char": "\\\\",
            "Replacement": ""
          },
          {
            "Char": ":",
            "Replacement": ""
          },
          {
            "Char": "#",
            "Replacement": ""
          },
          {
            "Char": "\u002B",
            "Replacement": "plus"
          },
          {
            "Char": "*",
            "Replacement": "star"
          },
          {
            "Char": "\u0026",
            "Replacement": ""
          },
          {
            "Char": "?",
            "Replacement": ""
          },
          {
            "Char": "\u00E6",
            "Replacement": "ae"
          },
          {
            "Char": "\u00E4",
            "Replacement": "ae"
          },
          {
            "Char": "\u00F8",
            "Replacement": "oe"
          },
          {
            "Char": "\u00F6",
            "Replacement": "oe"
          },
          {
            "Char": "\u00E5",
            "Replacement": "aa"
          },
          {
            "Char": "\u00FC",
            "Replacement": "ue"
          },
          {
            "Char": "\u00DF",
            "Replacement": "ss"
          },
          {
            "Char": "|",
            "Replacement": "-"
          },
          {
            "Char": "\u003C",
            "Replacement": ""
          },
          {
            "Char": "\u003E",
            "Replacement": ""
          }
        ]
      }
    }
  },
  "uSync": {
    "Settings": {
      "ImportAtStartup": "None",
      "ExportAtStartup": "None",
      "ExportOnSave": "None"
    }
  }
}