<Project Sdk="Microsoft.NET.Sdk.Razor">
    <PropertyGroup>
        <RootNamespace>N3O.Umbraco.ReactRuntime</RootNamespace>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>12</LangVersion>
        <Copyright>Copyright © 2026 N3O Ltd</Copyright>
        <NoWarn>NU1605;1591</NoWarn>
    </PropertyGroup>
    <PropertyGroup>
        <PackageId>N3O.Umbraco.ReactRuntime</PackageId>
        <IsPackable>true</IsPackable>
        <Authors>N3O Ltd</Authors>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Description>Shared self-hosted React 19 ESM runtime + import map for N3O Umbraco backoffice plugins.</Description>
        <PackageProjectUrl>https://n3o.ltd</PackageProjectUrl>
        <RepositoryUrl>https://github.com/n3oltd/umbraco-extensions</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <Version>17.0.0</Version>
        <AssemblyVersion>$(Version)</AssemblyVersion>
        <FileVersion>$(Version)</FileVersion>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\N3O.Umbraco.Extensions\N3O.Umbraco.Extensions.csproj" />
    </ItemGroup>
    <PropertyGroup>
        <!-- This project owns the shared npm workspace: it alone runs `npm ci` and the single Turbo build (see
             Directory.Build.targets). Every other frontend project takes a ProjectReference on it, which is what
             makes MSBuild order them after it, so the restore cannot run concurrently. -->
        <N3OFrontendAnchor>true</N3OFrontendAnchor>
        <!-- A directory, not a glob: a glob here expands at evaluation time, before Turbo has produced dist/
             (gitignored, absent on a clean checkout), so it ships nothing. BuildFrontend globs it at execution. -->
        <N3OFrontendExtraDistDir>$(MSBuildProjectDirectory)\..\frontend\backoffice-core\dist</N3OFrontendExtraDistDir>
    </PropertyGroup>
</Project>
