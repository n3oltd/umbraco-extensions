<Project Sdk="Microsoft.NET.Sdk.Razor">
    <PropertyGroup>
        <RootNamespace>N3O.Umbraco.EditorJs</RootNamespace>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>12</LangVersion>
        <Copyright>Copyright © 2026 N3O Ltd</Copyright>
        <NoWarn>NU1605;1591</NoWarn>
        <CopyDebugSymbolFilesFromPackages>true</CopyDebugSymbolFilesFromPackages>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
        <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
        <N3OReactPlugin>true</N3OReactPlugin>
        <!-- The site-side block partials under Views/ are MVC views. The Razor SDK only compiles them
             when this is set; it is implicit for the Web SDK but not for a class library. -->
        <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    </PropertyGroup>
    <PropertyGroup>
        <PackageId>N3O.Umbraco.EditorJs</PackageId>
        <IsPackable>true</IsPackable>
        <ContentTargetFolders>.</ContentTargetFolders>
        <Authors>N3O Ltd</Authors>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Description>Editor.js block-based rich text property editor for Umbraco, converting blocks to HTML</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageProjectUrl>https://n3o.ltd</PackageProjectUrl>
        <RepositoryUrl>https://github.com/n3oltd/umbraco-extensions</RepositoryUrl>
        <Version>17.0.0</Version>
        <AssemblyVersion>$(Version)</AssemblyVersion>
        <FileVersion>$(Version)</FileVersion>
        <RepositoryType>git</RepositoryType>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
        <DebugType>full</DebugType>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
        <DebugType>pdbonly</DebugType>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\..\Markup\N3O.Umbraco.Markup.Markdown\N3O.Umbraco.Markup.Markdown.csproj" />
        <ProjectReference Include="..\..\N3O.Umbraco.Plugins\N3O.Umbraco.Plugins.csproj" />
    </ItemGroup>
    <ItemGroup>
        <None Update="README.md">
            <Pack>True</Pack>
        </None>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="AngleSharp" Version="1.5.2" />
        <PackageReference Include="AngleSharp.Css" Version="0.18.0" />
    </ItemGroup>
</Project>
