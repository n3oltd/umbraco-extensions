<Project>
    <!-- Overrides the RazorCompileOnBuild false that web projects declare, so it must stay in a file imported
         after the csproj body. -->
    <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
        <RazorCompileOnBuild>true</RazorCompileOnBuild>
    </PropertyGroup>

    <Import Project="$(MSBuildThisFileDirectory)src\build\N3O.Umbraco.ReactPlugin.props"
            Condition="'$(N3OReactPlugin)' == 'true'" />

    <!-- Every other frontend project must reference the N3OFrontendAnchor project, or it can build before the
         workspace has been restored and built. -->
    <Target Name="RestoreFrontendDependencies"
            Condition="'$(N3OFrontendAnchor)' == 'true' And '$(DesignTimeBuild)' != 'true'"
            BeforeTargets="BeforeBuild"
            Inputs="$(N3OFrontendWorkspace)\package-lock.json"
            Outputs="$(N3OFrontendWorkspace)\node_modules\.n3o-frontend-restored">
        <Exec Command="npm ci" WorkingDirectory="$(N3OFrontendWorkspace)" />
        <Touch Files="$(N3OFrontendWorkspace)\node_modules\.n3o-frontend-restored" AlwaysCreate="true" />
    </Target>

    <!-- Guard: the restore's success marker is the .n3o-frontend-restored stamp, not merely node_modules
         (an interrupted npm ci leaves the dir but no stamp). If the stamp is missing, self-heal by running
         npm ci (idempotent) so a clean standalone pack works without first building the whole solution. -->
    <Target Name="EnsureFrontendDependenciesRestored"
            Condition="'$(N3OFrontendAnchor)' == 'true' And '$(DesignTimeBuild)' != 'true'"
            BeforeTargets="BuildFrontendWorkspace">
        <Exec Condition="!Exists('$(N3OFrontendWorkspace)\node_modules\.n3o-frontend-restored')"
              Command="npm ci" WorkingDirectory="$(N3OFrontendWorkspace)" />
        <Touch Condition="!Exists('$(N3OFrontendWorkspace)\node_modules\.n3o-frontend-restored')"
               Files="$(N3OFrontendWorkspace)\node_modules\.n3o-frontend-restored" AlwaysCreate="true" />
        <Error Condition="!Exists('$(N3OFrontendWorkspace)\node_modules\.n3o-frontend-restored')"
               Text="Frontend npm workspace is not restored (stamp '$(N3OFrontendWorkspace)\node_modules\.n3o-frontend-restored' missing). Run 'npm ci' in 'src' first." />
    </Target>

    <!-- Build the whole npm workspace exactly once with a single Turbo invocation, instead of each project
         running its own filtered turbo run (which raced on the shared @n3oltd/backoffice-core dist/.turbo when
         Cms and Data built in parallel under msbuild /m). -->
    <Target Name="BuildFrontendWorkspace"
            Condition="'$(N3OFrontendAnchor)' == 'true' And '$(DesignTimeBuild)' != 'true'"
            DependsOnTargets="EnsureFrontendDependenciesRestored"
            Inputs="$(N3OFrontendWorkspace)\package-lock.json;@(_N3OFrontendWorkspaceSources)"
            Outputs="$(N3OFrontendWorkspace)\node_modules\.n3o-frontend-built">
        <Exec Command="npx turbo run build --env-mode=loose"
              WorkingDirectory="$(N3OFrontendWorkspace)" />
        <Touch Files="$(N3OFrontendWorkspace)\node_modules\.n3o-frontend-built" AlwaysCreate="true" />
    </Target>

    <!-- Source inputs for the workspace-build incrementality check: every package's frontend sources except
         the generated dist/ and the turbo cache. Touching any source re-runs the single Turbo build. -->
    <ItemGroup Condition="'$(N3OHasFrontend)' == 'true'">
        <_N3OFrontendWorkspaceSources Include="$(N3OFrontendWorkspace)\**\frontend\**\*"
                                      Exclude="$(N3OFrontendWorkspace)\**\dist\**;$(N3OFrontendWorkspace)\**\.turbo\**;$(N3OFrontendWorkspace)\**\node_modules\**" />
    </ItemGroup>

    <!-- Per-project: copy only this project's own built dist into its wwwroot/App_Plugins. The Turbo build
         itself is done once by BuildFrontendWorkspace (above). N3OFrontendExtraDistDir lets a project ship a
         shared package's dist that lives outside its own frontend/ folder; it is a directory (globbed here, at
         execution time) rather than a pre-globbed item, so the dist need not exist at project evaluation. -->
    <Target Name="BuildFrontend"
            Condition="'$(N3OHasFrontend)' == 'true' And '$(DesignTimeBuild)' != 'true'"
            BeforeTargets="ResolveProjectStaticWebAssets"
            DependsOnTargets="ResolveProjectReferences;BuildFrontendWorkspace">
        <ItemGroup>
            <_N3OFrontendDist Include="$(MSBuildProjectDirectory)\frontend\*\dist\**\*" />
            <_N3OFrontendDist Include="$(N3OFrontendExtraDistDir)\**\*" Condition="'$(N3OFrontendExtraDistDir)' != ''" />
            <_N3OFrontendDist>
                <AppPluginsPath>$([System.Text.RegularExpressions.Regex]::Replace('%(Identity)', '^.*[\\/]dist[\\/]', ''))</AppPluginsPath>
            </_N3OFrontendDist>
        </ItemGroup>
        <Copy SourceFiles="@(_N3OFrontendDist)"
              DestinationFiles="@(_N3OFrontendDist->'$(MSBuildProjectDirectory)\wwwroot\App_Plugins\%(AppPluginsPath)')"
              SkipUnchangedFiles="true" />
        <!-- Register the just-copied bundles as Content so the static-web-assets pipeline picks them up
             (ResolveProjectStaticWebAssets feeds @(Content) under wwwroot/** into DefineStaticWebAssets).
             Because this target runs BeforeTargets that resolution and the bundles are generated (gitignored,
             absent at evaluation), the default wwwroot/** Content glob misses them; this re-adds them so
             build/pack/publish ship them (aspnetcore#38596). Relative path + Exclude="@(Content)" avoids a
             duplicate when a previous build left the file on disk and the eval-time glob already has it. -->
        <ItemGroup>
            <Content Include="@(_N3OFrontendDist->'wwwroot\App_Plugins\%(AppPluginsPath)')"
                     Exclude="@(Content)" />
        </ItemGroup>
    </Target>

    <PropertyGroup Condition="'$(N3OHasFrontend)' == 'true'">
        <ResolveStaticWebAssetsInputsDependsOn>BuildFrontend;$(ResolveStaticWebAssetsInputsDependsOn)</ResolveStaticWebAssetsInputsDependsOn>
        <GenerateStaticWebAssetsManifestDependsOn>BuildFrontend;$(GenerateStaticWebAssetsManifestDependsOn)</GenerateStaticWebAssetsManifestDependsOn>
    </PropertyGroup>
</Project>
